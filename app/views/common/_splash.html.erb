<section id="c-splash">
  <img class="preloader-image" width="64" height="64" src="data:image/svg+xml;base64,">
  <div class="preloader-text-wrapper">
    <div class="preloader-text">
      <%= I18n.t("ui.loading", default: "Loading") %>
    </div>
  </div>
</section>

<style>
  body:has(#c-splash) {
    overflow: hidden;
  }

  #c-splash {
    display: grid;
    place-items: center;
    align-content: center;
    gap: 1.75rem;
    backface-visibility: hidden;
    position: fixed;
    inset: 0;
    z-index: 1001;
    overflow: hidden;
    height: 100vh;
    background: radial-gradient(ellipse at center, var(--c-background-color, #0a0a0a) 0%, #000 80%);
  }

  #c-splash .preloader-image {
    width: 64px;
    height: 64px;
    animation: spin 1.2s linear infinite;
  }

  #c-splash .preloader-text-wrapper {
    opacity: 0;
    animation: fade-in 0.5s ease-in-out forwards;
    animation-delay: 0.8s;
  }

  #c-splash .preloader-text {
    position: relative;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 0.8rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
  }

  #c-splash .preloader-text:after {
    animation: loading-text 1.6s steps(4, end) infinite;
    content: "";
    position: absolute;
    left: 100%;
    margin-left: 0.1em;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  @keyframes fade-in {
    to { opacity: 1; }
  }

  @keyframes loading-text {
    0% { content: ""; }
    25% { content: "."; }
    50% { content: ".."; }
    75% { content: "..."; }
    100% { content: ""; }
  }
</style>