<style>
  .auth-card {
    background: var(--c-surface);
    border: 1px solid var(--c-surface-border);
    border-radius: 20px;
    padding: clamp(28px, 5vw, 44px) clamp(20px, 4vw, 36px);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    animation: auth-enter 0.35s ease both;
  }

  .auth-card__icon {
    width: 56px;
    height: 56px;
    margin: 0 auto 20px;
    border-radius: 50%;
    background: rgba(233,69,96,0.12);
    border: 1px solid rgba(233,69,96,0.22);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .auth-card__icon svg {
    width: 26px;
    height: 26px;
    color: var(--c-danger);
  }

  .auth-card__title {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--c-text);
    margin-bottom: 8px;
  }

  .auth-card__message {
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--c-text-muted);
    margin-bottom: 28px;
    max-width: 320px;
    margin-left: auto;
    margin-right: auto;
  }

  .auth-card__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 24px;
    border-radius: 12px;
    border: none;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: transform 0.15s ease, background 0.2s ease;
    background: var(--c-accent);
    color: #fff;
  }

  .auth-card__btn:hover {
    transform: translateY(-1px);
    filter: brightness(1.1);
  }

  .auth-card__btn:active {
    transform: translateY(0);
  }

  .auth-card__btn svg {
    width: 18px;
    height: 18px;
  }

  @keyframes auth-enter {
    from { opacity: 0; transform: translateY(10px) scale(0.98); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }
</style>

<div class="auth-card">
  <div class="auth-card__icon">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" />
    </svg>
  </div>
  <h1 class="auth-card__title">Authentication Error</h1>
  <p class="auth-card__message"><%= @error_message %></p>
  <a href="<%= root_path %>" class="auth-card__btn">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955a1.126 1.126 0 0 1 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
    </svg>
    Back to CinelarTV
  </a>
</div>
