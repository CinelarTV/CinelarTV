<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= yield(:title) || "CinelarTV" %></title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --c-bg: #0b0e14;
      --c-surface: rgba(255,255,255,0.05);
      --c-surface-border: rgba(255,255,255,0.08);
      --c-text: #f0f0f5;
      --c-text-muted: rgba(240,240,245,0.55);
      --c-accent: #42c0ff;
      --c-accent-glow: rgba(66,192,255,0.18);
      --c-danger: #e94560;
    }

    body {
      background: var(--c-bg);
      color: var(--c-text);
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      overflow: hidden;
      position: relative;
    }

    body::before,
    body::after {
      content: '';
      position: absolute;
      border-radius: 999px;
      filter: blur(80px);
      pointer-events: none;
      opacity: 0.4;
      z-index: 0;
    }

    body::before {
      width: min(38vw, 440px);
      height: min(38vw, 440px);
      top: -10%;
      right: -5%;
      background: var(--c-accent-glow);
    }

    body::after {
      width: min(30vw, 340px);
      height: min(30vw, 340px);
      bottom: -8%;
      left: -5%;
      background: rgba(233,69,96,0.12);
    }

    .auth-shell {
      position: relative;
      z-index: 1;
      width: min(420px, 92vw);
      text-align: center;
    }
  </style>
</head>
<body>
  <div class="auth-shell">
    <%= yield %>
  </div>
</body>
</html>
